<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Warn"
      internalLogFile="${basedir}/logs/internal-nlog.txt">

  <extensions>
    <add assembly="NLog.Web.AspNetCore" />
  </extensions>

  <!-- aspnet-TraceIdentifier = ה-CorrelationId של הבקשה -->
  <variable name="line"
            value="${longdate}|${level:uppercase=true}|${aspnet-TraceIdentifier}|${logger}|${message} ${exception:format=tostring}" />

  <targets>
    <target xsi:type="File" name="file" fileName="${basedir}/logs/${shortdate}.log" layout="${line}" encoding="utf-8" />
    <target xsi:type="Console" name="console" layout="${line}" />
  </targets>

  <rules>
    <!-- הסינון לפי רמה נעשה ב-appsettings (Logging:LogLevel) -->
    <logger name="*" minlevel="Trace" writeTo="file,console" />
  </rules>
</nlog>
